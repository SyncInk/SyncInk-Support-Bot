# SyncInk Security Dashboard Environment Variables
# Copy these into your Vercel Project Settings -> Environment Variables

# 1. PostgreSQL Database URL (Same one your bot uses on Railway/Supabase/Neon)
DATABASE_URL="postgresql://postgres:password@host:port/dbname"

# 2. Discord Application OAuth2 Credentials (from Discord Developer Portal)
DISCORD_CLIENT_ID="your_discord_bot_client_id"
DISCORD_CLIENT_SECRET="your_discord_bot_client_secret"

# 3. Server Configuration
# Your Discord Server (Guild) ID
DEFAULT_GUILD_ID="1520461877073674392"

# 4. Access Control (Optional: comma-separated Discord User IDs allowed to access dashboard)
# If left empty, server ownership or Administrator permissions in DEFAULT_GUILD_ID will be checked.
AUTHORIZED_DISCORD_IDS="your_discord_user_id"

# 5. Backup Admin Passkey
ADMIN_ACCESS_KEY="choose_a_strong_secret_passkey"

# 6. NextAuth / Dashboard Base URL (Required in production, e.g. https://your-domain.vercel.app)
NEXTAUTH_URL="https://your-dashboard.vercel.app"
